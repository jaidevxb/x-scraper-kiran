# ---------------------------------------------------------------------------
# X (Twitter) daily scraper — configuration
# Copy this file to `.env` and fill in APIFY_TOKEN.
# The real .env must be chmod 600 (install.sh does this for you).
# ---------------------------------------------------------------------------

# --- Apify ---------------------------------------------------------------
APIFY_TOKEN=
APIFY_ACTOR_ID=apidojo~tweet-scraper

# --- What to collect ------------------------------------------------------
# X handle, without the leading "@".
X_HANDLE=emollick

# Hashtag, without the leading "#". X search is case-insensitive.
HASHTAG=GeminiEnterprise

# --- Where to write -------------------------------------------------------
# Everything (data/, state/, logs/) lives under this directory.
# "~" is expanded. Keep it out of Documents/Desktop/iCloud to avoid macOS
# permission prompts for a background job.
BASE_DIR=~/XScraper

# Day-folder naming: "iso" -> 2026-09-15   |   "long" -> 15 september
DATE_FOLDER_FORMAT=iso

# --- Volume caps (per run, per source) ------------------------------------
MAX_POSTS_USER=100
MAX_POSTS_HASHTAG=300

# --- Time window ----------------------------------------------------------
# How many days back each run re-checks. Catches posts made after the
# scheduled run time, and self-heals days that were missed or failed.
LOOKBACK_DAYS=3

# Timezone used for day boundaries and folder names.
# Leave BLANK to use the machine's local timezone (what we want on the Mac).
# Set e.g. Asia/Kolkata or America/New_York to pin it explicitly.
TIMEZONE=

# --- Filtering ------------------------------------------------------------
# Pure retweets are never useful as standalone posts.
INCLUDE_RETWEETS=false
# Ethan's own replies often contain real substance -> keep them.
INCLUDE_USER_REPLIES=true
# Replies from strangers in the hashtag feed are mostly noise -> drop them.
INCLUDE_HASHTAG_REPLIES=false

# --- Media ----------------------------------------------------------------
DOWNLOAD_MEDIA=true
# For videos/GIFs: download the poster image and record the video URL.
# Set true to also download the highest-bitrate MP4 (files get big).
DOWNLOAD_VIDEO_FILES=false
MEDIA_TIMEOUT_SECONDS=60

# --- Scheduling (must match the LaunchAgent plist) ------------------------
# Used by the "has today's run already happened?" guard.
SCHEDULE_HOUR=22
SCHEDULE_MINUTE=0

# --- Reliability ----------------------------------------------------------
ACTOR_TIMEOUT_SECONDS=1800
HTTP_RETRIES=4
MIN_FREE_DISK_MB=500
NOTIFY_ON_FAILURE=true
LOG_LEVEL=INFO

# Keep the raw Apify JSON next to each post.md (useful while debugging).
SAVE_RAW=false
